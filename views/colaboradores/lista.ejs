<%- include('../partials/header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0">Colaboradores</h1>
  <a href="/colaboradores/novo" class="btn btn-primary"><i class="bi bi-person-plus"></i> Novo colaborador</a>
</div>

<form class="row g-2 mb-3" method="get">
  <div class="col-md-10"><input type="search" name="q" value="<%= busca %>" class="form-control" placeholder="Buscar por nome ou CPF"></div>
  <div class="col-md-2 d-grid"><button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Buscar</button></div>
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Nome</th><th>CPF</th><th>Termos</th><th class="text-end">Ações</th></tr></thead>
      <tbody>
        <% if (!colaboradores.length) { %>
          <tr><td colspan="4" class="text-center text-muted py-4">Nenhum colaborador encontrado.</td></tr>
        <% } %>
        <% colaboradores.forEach(c => { %>
          <tr>
            <td><%= c.nome %></td>
            <td><%= c.cpf %></td>
            <td>
              <a href="/termos?q=<%= encodeURIComponent(c.cpf) %>"><%= c.qtd_termos %></a>
              <% if (c.termos_ativos) { %><span class="badge text-bg-primary ms-1"><%= c.termos_ativos %> ativo(s)</span><% } %>
            </td>
            <td class="text-end text-nowrap">
              <a href="/termos/novo?colaborador_id=<%= c.id %>" class="btn btn-sm btn-outline-success" title="Emitir termo"><i class="bi bi-file-earmark-plus"></i></a>
              <a href="/colaboradores/<%= c.id %>/editar" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
              <form action="/colaboradores/<%= c.id %>/excluir" method="post" class="d-inline" data-confirm="Excluir o colaborador <%= c.nome %>?">
                <button class="btn btn-sm btn-outline-danger" title="Excluir" <%= c.qtd_termos ? 'disabled' : '' %>><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
