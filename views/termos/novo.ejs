<%- include('../partials/header') %>
<% const modo = old.colaborador_modo === 'novo' ? 'novo' : 'existente'; const selecionados = (old.equipamentos || []).map(String); %>
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/termos">Termos</a></li><li class="breadcrumb-item active">Emitir termo</li></ol></nav>
<h1 class="h3 mb-3">Emitir Termo de Responsabilidade</h1>
<% if (erroForm) { %><div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= erroForm %></div><% } %>

<form method="post" action="/termos" id="form-termo">
  <div class="card mb-4">
    <div class="card-header fw-semibold">1. Colaborador</div>
    <div class="card-body">
      <div class="btn-group mb-3" role="group">
        <input type="radio" class="btn-check" name="colaborador_modo" id="modo-existente" value="existente" <%= modo === 'existente' ? 'checked' : '' %>>
        <label class="btn btn-outline-primary" for="modo-existente"><i class="bi bi-person-check"></i> Selecionar existente</label>
        <input type="radio" class="btn-check" name="colaborador_modo" id="modo-novo" value="novo" <%= modo === 'novo' ? 'checked' : '' %>>
        <label class="btn btn-outline-primary" for="modo-novo"><i class="bi bi-person-plus"></i> Cadastrar novo</label>
      </div>

      <div id="bloco-existente" class="<%= modo === 'novo' ? 'd-none' : '' %>">
        <% if (!colaboradores.length) { %>
          <div class="text-muted">Nenhum colaborador cadastrado. Use a opção "Cadastrar novo".</div>
        <% } else { %>
          <input type="search" class="form-control mb-2" id="filtro-colab" placeholder="Filtrar por nome ou CPF...">
          <select name="colaborador_id" id="colaborador_id" class="form-select" size="6">
            <% colaboradores.forEach(c => { %>
              <option value="<%= c.id %>" <%= old.colaborador_id === String(c.id) ? 'selected' : '' %>><%= c.nome %> — <%= c.cpf %></option>
            <% }) %>
          </select>
        <% } %>
      </div>

      <div id="bloco-novo" class="row g-3 <%= modo === 'novo' ? '' : 'd-none' %>">
        <div class="col-md-8">
          <label class="form-label">Nome completo *</label>
          <input name="novo_nome" class="form-control" value="<%= old.novo_nome || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">CPF *</label>
          <input name="novo_cpf" class="form-control" data-mask="cpf" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" value="<%= old.novo_cpf || '' %>">
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
      <span class="fw-semibold">2. Equipamentos disponíveis</span>
      <span class="badge text-bg-primary" id="contador-sel">0 selecionado(s)</span>
    </div>
    <div class="card-body pb-0">
      <input type="search" class="form-control" id="filtro-equip" placeholder="Filtrar por tipo, modelo, patrimônio ou série...">
    </div>
    <div class="table-responsive equip-scroll">
      <table class="table table-hover mb-0 align-middle" id="tabela-equip">
        <thead class="sticky-top"><tr><th style="width:40px"></th><th>Tipo</th><th>Marca/Modelo</th><th>Patrimônio</th><th>Nº de série</th><th>Acessórios</th></tr></thead>
        <tbody>
          <% if (!equipamentos.length) { %>
            <tr><td colspan="6" class="text-center text-muted py-4">Nenhum equipamento disponível. <a href="/equipamentos/novo">Cadastrar equipamento</a>.</td></tr>
          <% } %>
          <% equipamentos.forEach(e => { %>
            <tr class="equip-row">
              <td><input type="checkbox" class="form-check-input equip-check" name="equipamentos" value="<%= e.id %>" id="eq-<%= e.id %>" <%= selecionados.includes(String(e.id)) ? 'checked' : '' %>></td>
              <td><label for="eq-<%= e.id %>" class="stretched-label"><%= e.tipo %></label></td>
              <td><%= e.marca_modelo %></td>
              <td><%= e.patrimonio || '—' %></td>
              <td><%= e.numero_serie || '—' %></td>
              <td class="small text-muted"><%= e.acessorios || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-flex gap-2">
    <button class="btn btn-success btn-lg" id="btn-emitir"><i class="bi bi-file-earmark-pdf"></i> Emitir termo e gerar PDF</button>
    <a href="/termos" class="btn btn-outline-secondary btn-lg">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
